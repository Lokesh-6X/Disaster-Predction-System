# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL) ---
# scripts/init_db.ps1 creates this user and database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weather
DB_USER=weather
DB_PASSWORD=change-me

# --- MQTT broker (this project's own Mosquitto on port 1884) ---
# scripts/setup_broker.ps1 creates these users in config/mosquitto/passwd.
MQTT_HOST=localhost
MQTT_PORT=1884
MQTT_USERNAME=backend
MQTT_PASSWORD=change-me
# Kit credentials (also used by the kit simulator)
MQTT_KIT_USERNAME=kit01
MQTT_KIT_PASSWORD=change-me

# --- Admin user (created on first start if no user exists) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=8

# --- Email ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true, app password in SMTP_PASSWORD
# Mailpit (local test inbox): SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_STARTTLS=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=weather-alerts@example.com
SMTP_STARTTLS=false

# --- Web ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
